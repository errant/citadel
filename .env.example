# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=

# Discord OAuth application (https://discord.com/developers/applications)
# Redirect URL (SvelteKit Auth.js default):
#   http://localhost:5173/auth/callback/discord
#   https://YOUR_DOMAIN/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Canonical site URL in production (e.g. https://citadel.example.com)
AUTH_URL=http://localhost:5173

# Usually fine on Vercel; set true if host inference fails on another host
AUTH_TRUST_HOST=true
