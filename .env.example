# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Canonical site URL (used to build OAuth callback URLs)
# Local: http://localhost:5173  (or http://127.0.0.1:5173 — use the same host you open in the browser)
# Prod:  https://YOUR_DOMAIN
BETTER_AUTH_URL=http://localhost:5173

# Discord OAuth (https://discord.com/developers/applications)
# Redirect URL (Better Auth default):
#   http://localhost:5173/api/auth/callback/discord
#   https://YOUR_DOMAIN/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# MVP uses Better Auth database-less (stateless cookie) sessions — no DATABASE_URL required.
# Add Neon/Turso later when you need durable users, revocation, or admin tooling.
